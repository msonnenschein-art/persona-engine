# Persona Engine Environment Configuration
# Copy this file to .env and fill in your values.
# In production (Railway), set these in the Railway variable dashboard instead.

# ── LLM API Keys ────────────────────────────────────────────────────────────

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your-openai-api-key-here

# ── Engine ───────────────────────────────────────────────────────────────────

# Default provider (anthropic or openai)
# PERSONA_DEFAULT_PROVIDER=anthropic

# Default model (optional, uses provider default if not set; also used by the Discord bot)
# PERSONA_DEFAULT_MODEL=claude-sonnet-4-6

# ── Discord Bot ───────────────────────────────────────────────────────────────

# Discord Bot Token (from the Discord Developer Portal)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Character the Discord bot loads at startup (filename stem under characters/)
DISCORD_CHARACTER=reva_sample

# Salt used when hashing Discord user IDs for storage (any random string).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: changing this invalidates all existing user records.
HASH_SALT=your-random-salt-here

# Path to the SQLite database file.
# In production, point this at a Railway persistent volume mount (e.g. /data/bot.db).
# DB_PATH=./data/bot.db

# Discord channel ID for the daily heartbeat message and DB backup.
# Leave unset (or empty) to disable the heartbeat — safe for local dev.
# HEARTBEAT_CHANNEL_ID=
